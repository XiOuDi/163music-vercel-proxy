# ============================================
# 网易云音乐 Vercel 音频代理 - 环境配置
# ============================================

# Upstash Redis 配置（推荐，自动同步 Bot Cookie）
# 在 Upstash 控制台获取：https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=https://your-project.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# 网易云 Cookie（可选，优先使用 Upstash）
# 格式：MUSIC_U=xxx; 其他cookie=xxx
NETEASE_COOKIE=

# 真实 IP（可选，部分场景可提升可用性）
REAL_IP=
