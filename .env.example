# Netease Cloud Music Cookie (可选，优先使用 Upstash)
NETEASE_COOKIE=

# Real IP Address (Optional)
REAL_IP=

# QQ Music Cookie
QQ_COOKIE=

# Kugou Music Cookie
KUGOU_COOKIE=

# ============================================
# Upstash Redis 配置（推荐，自动同步 Bot Cookie）
# ============================================
# Upstash REST URL（在 Upstash 控制台获取）
UPSTASH_REDIS_REST_URL=https://your-project.upstash.io

# Upstash REST Token（在 Upstash 控制台获取）
UPSTASH_REDIS_REST_TOKEN=your-token-here

# Cookie 在 Upstash 中的 key（Bot 写入的 key）
# 支持以下 key 自动检测：
# - netease:cookie (完整 Cookie)
# - netease:music_u (仅 MUSIC_U)
# - cookie:music_u (Bot 默认格式)
